<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.obsidian-sync-example</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/<user>/path/to/obsidian-sync-example.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/<user>/Library/Logs/obsidian-sync.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/<user>/Library/Logs/obsidian-sync-error.log</string>
</dict>
</plist>
